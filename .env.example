# Export these values in your shell or set them on the deployment.
# The server does not automatically load .env files.

# Default: stdio uses a fixed key; HTTP callers supply their own X-API-Key.
TRACKPAC_AUTH=api-key
TRACKPAC_API_KEY=

# Optional: use the API endpoint supplied for your Trackpac deployment.
# TRACKPAC_API_URL=https://api.trackpac.io

# To enable Auth0 OAuth, set TRACKPAC_AUTH=auth0, leave TRACKPAC_API_KEY unset,
# and supply the configuration agreed with your Trackpac deployment operator.
# AUTH0_DOMAIN=your-trackpac-login-domain
# AUTH0_CLIENT_ID=your-dedicated-mcp-application-client-id
# AUTH0_CLIENT_SECRET=your-dedicated-mcp-application-client-secret
# AUTH0_AUDIENCE=your-trackpac-api-audience
# MCP_SERVER_URL=https://mcp.trackpac.io
# OAUTH_JWT_SIGNING_KEY=generate-with-openssl-rand-hex-32
# FASTMCP_HOME=/data/fastmcp
