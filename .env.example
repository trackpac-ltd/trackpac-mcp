# Copy to .env (or set this as a real environment variable / in your MCP
# client's server config).

# Your Trackpac API key (sent as the X-API-Key header). This server is
# API-key-only — bearer tokens are not supported.
TRACKPAC_API_KEY=

# Optional: point at staging or a local v2-api instead of production.
# TRACKPAC_API_URL=http://localhost:8000
